nh con dùng chung" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="830" y="90" width="360" height="520" as="geometry"/></mxCell><mxCell id="npu-04-pp" value="O_P_REQ → O_P_WAIT&lt;br&gt;đọc llm_parameter_ram" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="850" y="125" width="320" height="60" as="geometry"/></mxCell><mxCell id="npu-04-_t5" value="return_p" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1205" y="137" width="120" height="36" as="geometry"/></mxCell><mxCell id="npu-04-vv" value="O_V_REQ → O_V_WAIT&lt;br&gt;đọc u_vectors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="850" y="203" width="320" height="60" as="geometry"/></mxCell><mxCell id="npu-04-_t6" value="return_v" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1205" y="215" width="120" height="36" as="geometry"/></mxCell><mxCell id="npu-04-kk" value="O_K_REQ → O_K_WAIT&lt;br&gt;đọc KV cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="850" y="281" width="320" height="60" as="geometry"/></mxCell><mxCell id="npu-04-_t7" value="return_k" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1205" y="293" width="120" height="36" as="geometry"/></mxCell><mxCell id="npu-04-mm" value="O_M_START → O_M_WAIT&lt;br&gt;chạy llm_math" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="850" y="359" width="320" height="60" as="geometry"/></mxCell><mxCell id="npu-04-_t8" value="return_m" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1205" y="371" width="120" height="36" as="geometry"/></mxCell><mxCell id="npu-04-ww" value="O_WRITE&lt;br&gt;ghi u_vectors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="850" y="437" width="320" height="60" as="geometry"/></mxCell><mxCell id="npu-04-_t9" value="return_w" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1205" y="449" width="120" height="36" as="geometry"/></mxCell><mxCell id="npu-04-sc" value="SC_ROUTE → SC_MULTIPLY&lt;br&gt;→ SC_PAIR → SC_SUM&lt;br&gt;nhân hệ số" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="850" y="515" width="320" height="60" as="geometry"/></mxCell><mxCell id="npu-04-_t10" value="return_scalar" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1205" y="527" width="120" height="36" as="geometry"/></mxCell><mxCell id="npu-04-_e11" style="endArrow=block;html=1;rounded=0;endFill=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="npu-04-g_ph" target="npu-04-g_sub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="npu-04-_l12" value="call: ghi return_* rồi nhảy" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="npu-04-_e11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="npu-04-_e13" style="endArrow=block;html=1;rounded=0;endFill=1;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="npu-04-g_sub" target="npu-04-g_ph"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="npu-04-_l14" value="return: nhảy theo nhãn return_*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="npu-04-_e13"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="npu-04-fin" value="O_FINISH&lt;br&gt;chờ ghi xong → op_done" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="660" width="290" height="50" as="geometry"/></mxCell><mxCell id="npu-04-_e15" style="endArrow=block;html=1;rounded=0;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="npu-04-g_ph" target="npu-04-fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="npu-04-_e16" style="endArrow=block;html=1;rounded=0;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="npu-04-fin" target="npu-04-gr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="685"/></Array></mxGeometry></mxCell><mxCell id="npu-04-_l17" value="op_done" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="npu-04-_e16"><mxGeometry x="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="npu-04-_t18" value="Ví dụ: O_IDLE của pha G_Q đặt p_address = hàng META của Wq, ghi return_p = RET_P_L_META rồi nhảy tới O_P_REQ. Khi O_P_WAIT nhận dữ liệu, FSM xét nhãn trong return_p và nhảy tới L_META — giống lệnh call / return của CPU, nhưng địa chỉ trở về là một nhãn enum nhỏ (RET_P_*, RET_V_*, …) chứ không phải số trạng thái.&lt;br&gt;Mỗi trạng thái là một bit của thanh ghi one-hot op; ENABLE_DEBUG_INDEX = 1 mã hóa nó thành số 7 bit trong instr_debug." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="640" width="790" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="npu-05" name="05 Bản đồ bộ nhớ"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="npu-05-_t1" value="llm_soc — Bản đồ bộ nhớ" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell><mxCell id="npu-05-_t2" value="llm_parameter_ram (24576 hàng × 256 bit), u_vectors (8 khe vector) và u_cache (KV cache). Số hàng viết ở hệ thập phân." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1500" height="20" as="geometry"/></mxCell><mxCell id="npu-05-ph" value="llm_parameter_ram" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="420" height="30" as="geometry"/></mxCell><mxCell id="npu-05-r0" value="Embedding int8 · hàng 0 – 16383&lt;br&gt;4096 token × 4 hàng" st