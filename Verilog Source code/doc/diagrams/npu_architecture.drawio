<mxfile host="app.diagrams.net" agent="gen_drawio.py" version="24.0.0"><diagram id="npu-00" name="00 Chú thích và mục lục"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="npu-00-_t1" value="NPU — Chú thích màu và mục lục sơ đồ" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell><mxCell id="npu-00-_t2" value="Mỗi trang là một góc nhìn: từ khối tổng quát xuống FSM, bộ nhớ và NPU legacy. Giải thích chi tiết nằm trong các file .md của thư mục doc/." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1500" height="20" as="geometry"/></mxCell><mxCell id="npu-00-lh" value="Chú thích màu" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="420" height="30" as="geometry"/></mxCell><mxCell id="npu-00-lg0" value="ctrl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="100" height="36" as="geometry"/></mxCell><mxCell id="npu-00-_t3" value="Điều khiển: FSM, bộ lập lịch, PC" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="140" width="310" height="36" as="geometry"/></mxCell><mxCell id="npu-00-lg1" value="move" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="100" height="36" as="geometry"/></mxCell><mxCell id="npu-00-_t4" value="Di chuyển dữ liệu: bus host, đọc/ghi bộ nhớ" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="190" width="310" height="36" as="geometry"/></mxCell><mxCell id="npu-00-lg2" value="param" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="100" height="36" as="geometry"/></mxCell><mxCell id="npu-00-_t5" value="Bộ nhớ: tham số, vector, KV cache, SRAM" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="240" width="310" height="36" as="geometry"/></mxCell><mxCell id="npu-00-lg3" value="mac" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="100" height="36" as="geometry"/></mxCell><mxCell id="npu-00-_t6" value="Tính toán MAC: nhân, cộng dồn, ternary" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="290" width="310" height="36" as="geometry"/></mxCell><mxCell id="npu-00-lg4" value="act" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="100" height="36" as="geometry"/></mxCell><mxCell id="npu-00-_t7" value="Hàm kích hoạt / hậu xử lý: norm, sigmoid, exp, chia" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="340" width="310" height="36" as="geometry"/></mxCell><mxCell id="npu-00-lg5" value="reg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="100" height="36" as="geometry"/></mxCell><mxCell id="npu-00-_t8" value="Thanh ghi cấu hình / trạng thái" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="390" width="310" height="36" as="geometry"/></mxCell><mxCell id="npu-00-lgh" value="Host" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="100" height="36" as="geometry"/></mxCell><mxCell id="npu-00-_t9" value="Bên ngoài NPU (CPU / testbench)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="440" width="310" height="36" as="geometry"/></mxCell><mxCell id="npu-00-ea" value="A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="60" height="30" as="geometry"/></mxCell><mxCell id="npu-00-eb" value="B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="500" width="60" height="30" as="geometry"/></mxCell><mxCell id="npu-00-_e10" style="endArrow=block;html=1;rounded=0;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="npu-00-ea" target="npu-00-eb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="npu-00-_t11" value="Mũi tên liền: dữ liệu" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="500" width="200" height="30" as="geometry"/></mxCell><mxCell id="npu-00-ec" value="A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="60" height="30" as="geometry"/></mxCell><mxCell id="npu-00-ed" value="B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="550" width="60" height="30" as="geometry"/></mxCell><mxCell id="npu-00-_e12" style="endArrow=open;html=1;rounded=0;endFill=0;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="npu-00-ec" target="npu-00-ed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="npu-00-_t13" value="Mũi tên đứt: điều khiển / ra lệnh" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="550" width="200" height="30" as="geometry"/></mxCell><mxCell id="npu-00-eg" value="Khung đứt nét" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="200" height="60" as="geometry"/></mxCell><mxCell id="npu-00-_t14" value="Nhóm khối cùng chức năng" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="615" width="200" height="30" as="geometry"/></mxCell><mxCell id="npu-00-_t15" value="Trong trang FSM (03, 04, 06): mỗi ô là một trạng thái, mũi tên liền là chuyển trạng thái, nhãn trên mũi tên là điều kiện." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="420" height="50" as="geometry"/></mxCell><mxCell id="npu-00-ih" value="Mục lục trang" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="620" height="30" as="geometry"/></mxCell><mxCell id="npu-00-ix0" value="01 llm_soc — sơ đồ khối tổng quát (high level arch)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="620" height="36" as="geometry"/></mxCell><mxCell id="npu-00-ix1" value="02 Cây module của llm_soc và matmulfree" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="620" height="36" as="geometry"/></mxCell><mxCell id="npu-00-ix2" value="03 FSM đồ thị của llm_soc: dòng chảy một vị trí token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520" y="240" width="620" height="36" as="geometry"/></mxCell><mxCell id="npu-00-ix3" value="04 FSM thao tác của llm_soc: gọi / trở về (call / return)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="620" height="36" as="geometry"/></mxCell><mxCell id="npu-00-ix4" value="05 Bản đồ bộ nhớ của llm_soc: tham số, khe vector, địa chỉ KV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520" y="340" width="620" height="36" as="geometry"/></mxCell><mxCell id="npu-00-ix5" value="06 NPU legacy matmulfree: sơ đồ khối + bộ lập lịch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="520" y="390" width="620" height="36" as="geometry"/></mxCell><mxCell id="npu-00-_t16" value="Tài liệu đi kèm: doc/00_kien_thuc_nen.md (kiến thức nền), 01_tong_quan_kien_truc.md, 02_hoat_dong_chi_tiet_llm_soc.md, 03_npu_legacy_matmulfree.md, doc/modules/*.md (từng module)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="460" width="620" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="npu-01" name="01 llm_soc high level arch"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="npu-01-_t1" value="llm_soc — Sơ đồ khối tổng quát (high level architecture)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell><mxCell id="npu-01-_t2" value="NPU suy luận LLM nhỏ: 4 lớp, 128 kênh, 4 đầu attention, 4096 token. Dữ liệu trung gian nằm hết trong chip; host chỉ nạp tham số, prompt và đọc token." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1500" height="20" as="geometry"/></mxCell><mxCell id="npu-01-host" value="Host&lt;br&gt;(CPU / testbench)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="120" height="60" as="geometry"/></mxCell><mxCell id="npu-01-g_hif" value="1. Giao tiếp host" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="260" height="590" as="geometry"/></mxCell><mxCell id="npu-01-bus" value="Cổng host&lt;br&gt;32 bit&lt;br&gt;&lt;br&gt;H_IDLE&lt;br&gt;→ H_EXEC&lt;br&gt;→ H_DONE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="205" y="140" width="70" height="530" as="geometry"/></mxCell><mxCell id="npu-01-cfg" value="Thanh ghi cấu hình&lt;br&gt;+ trạng thái&lt;br&gt;launch, max_new, seed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="135" height="60" as="geometry"/></mxCell><mxCell id="npu-01-prm" value="prompt_memory&lt;br&gt;128 × 12 bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="135" height="60" as="geometry"/></mxCell><mxCell id="npu-01-out" value="output_memory&lt;br&gt;128 × 12 bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="600" width="135" height="50" as="geometry"/></mxCell><mxCell id="npu-01-g_cc" value="2. Điều khiển trung tâm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="560" height="120" as="geometry"/></mxCell><mxCell id="npu-01-gr" value="FSM đồ thị (G_*)&lt;br&gt;+ chọn token đầu vào" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="240" height="60" as="geometry"/></mxCell><mxCell id="npu-01-op" value="FSM thao tác (microcode one-hot)&lt;br&gt;gọi / trở về các chương trình con" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="140" width="240" height="60" as="geometry"/></mxCell><mxCell id="npu-01-g_mem" value="3. Bộ nhớ trên chip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="240" height="490" as="geometry"/></mxCell><mxCell id="npu-01-g_mac" value="4. Khối tính toán MAC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="250" width="260" height="490" as="geometry"/></mxCell><mxCell id="npu-01-g_act" value="5. Hàm kích hoạt / hậu xử lý" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="250" width="260" height="490" as="geometry"/></mxCell><mxCell id="npu-01-par" value="llm_parameter_ram&lt;br&gt;24576 hàng × 256 bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="200" height="60" as="geometry"/></mxCell><mxCell id="npu-01-vec" value="u_vectors&lt;br&gt;8 khe vector" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="440" width="200" height="60" as="geometry"/></mxCell><mxCell id="npu-01-kv" value="u_cache&lt;br&gt;KV cache 4 lớp × 128 vị trí" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="590" width="200" height="60" as="geometry"/></mxCell><mxCell id="npu-01-lin" value="llm_linear_engine&lt;br&gt;+ ternary_d