d" target="npu-03-emb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="715" y="560"/><mxPoint x="40" y="560"/><mxPoint x="40" y="160"/></Array></mxGeometry></mxCell><mxCell id="npu-03-_l28" value="sinh tiếp (vị trí + 1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="npu-03-_e27"><mxGeometry x="-0.5" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="npu-03-mem" value="Khe vector u_vectors: 0 x · 1 norm / kết quả linear · 2 q · 3 k · 4 v · 5 attention · 6 gate / SiLU · 7 up" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="800" height="40" as="geometry"/></mxCell><mxCell id="npu-03-_t29" value="Còn token prompt ở lớp 3 → quay lại G_EMBED mà không qua HEAD: chỉ token cuối của prompt mới cần sinh logit.&lt;br&gt;Mọi pha gặp lỗi (op_fault) → G_DONE với error = 1. Bốn lớp chạy lại cùng chuỗi G_ANORM … G_MADD." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="1100" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="npu-04" name="04 FSM thao tác"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="npu-04-_t1" value="llm_soc — FSM thao tác: chương trình con dùng chung (call / return)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell><mxCell id="npu-04-_t2" value="Mỗi pha G_* chạy một chuỗi trạng thái riêng. Việc lặp lại (đọc / ghi bộ nhớ, chạy llm_math, nhân hệ số) được viết một lần và gọi qua thanh ghi return_*." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1500" height="20" as="geometry"/></mxCell><mxCell id="npu-04-gr" value="FSM đồ thị&lt;br&gt;op_start (pha)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="140" height="60" as="geometry"/></mxCell><mxCell id="npu-04-idle" value="O_IDLE&lt;br&gt;chọn bước đầu theo pha" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="230" y="300" width="160" height="60" as="geometry"/></mxCell><mxCell id="npu-04-g_ph" value="Trạng thái riêng của từng pha" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="330" height="520" as="geometry"/></mxCell><mxCell id="npu-04-e" value="E_* embedding" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="125" width="290" height="40" as="geometry"/></mxCell><mxCell id="npu-04-n" value="N_* / NR_* RMSNorm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="178" width="290" height="40" as="geometry"/></mxCell><mxCell id="npu-04-l" value="L_* linear (ternary)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="231" width="290" height="40" as="geometry"/></mxCell><mxCell id="npu-04-r" value="R_* RoPE" style="roun