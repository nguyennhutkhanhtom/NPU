# Keep raw source/asset hashes identical after checkout on every platform.
.gitignore text eol=lf
.gitattributes text eol=lf
*.sv text eol=lf
*.v text eol=lf
*.svh text eol=lf
*.mem text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.tcl text eol=lf
*.qpf text eol=lf
*.qsf text eol=lf
*.sdc text eol=lf
*.html text eol=lf
*.cjs text eol=lf
*.rpt text eol=lf
*.log text eol=lf
# Preserve Quartus/ModelSim report formatting as generated evidence.
*.rpt -whitespace
*.log -whitespace
docs/verification/timing/** -whitespace
*.summary text eol=lf
*.txt text eol=lf
*.bin binary
*.png binary
*.pdf binary
*.pptx binary
*.zip binary
# Evidence manifests hash raw simulator logs/command JSON. Disable EOL filters
# within evidence so a Git checkout preserves those byte-exact hashes.
docs/verification/timing/** -text
docs/verification/memory_ip/** -text -whitespace
tests/full_rtl/evidence/** -text -whitespace
tests/full_rtl/unit_results.json -text -whitespace
tests/evidence/** -text -whitespace
docs/verification/io_cells/** -text -whitespace
docs/verification/synthesis/** -text -whitespace
docs/verification/portable_elaboration1/** -text -whitespace
docs/verification/rtl_policy_attention1/** -text -whitespace
docs/verification/portable_elaboration_attention1/** -text -whitespace
docs/verification/rtl_policy_cache1/** -text -whitespace
