        <mxCell id="n1" value="00_TOP: llm_soc / portable SRAM behavior" style="whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=24;shadow=0;align=left;verticalAlign=top;spacing=12;strokeColor=none;" vertex="1" parent="1">
