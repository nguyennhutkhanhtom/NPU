<diagram id="33b_llm_soc_attention_control" name="llm_soc — attention credits and completion"><mxGraphModel dx="900" dy="895" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="900" pageHeight="895" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="llm_soc — attention credits and completion" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="840" height="30" as="geometry" /></mxCell><mxCell id="subtitle" value="Current RTL: pipelined attention value pass&lt;br/&gt;RTL: llm_soc.sv · clk; raw rst_n → u_reset → core_rst_n" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="840" height="42" as="geometry" /></mxCell><mxCell id="n_N0" value="Launch when QK scores complete without a fault&lt;br/&gt;Reset score / request / response / capture / retire counters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Arial;spacing=8;" vertex="1" parent="1" rtlSource="llm_soc.sv" architectureKind="functional logic"><mxGeometry x="200" y="125" width="500" height="76" as="geometry" /></mxCell><mxCell id="n_N1" value="Exp output requests V only with a reserved slot available&lt;br/&gt;request - capture &amp;lt; 8, or capture frees a slot this clock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Arial;spacing=8;" vertex="1" parent="1" rtlSource="llm_soc.sv" architectureKind="functional logic"><mxGeometry x="200" y="230" width="500" height="76" as="geometry" /></mxCell><mxCell id="n_N2" value="KV responses use slots reserved at request acceptance&lt;br/&gt;Capture oldest pair; math ready controls operand consumption" style="rounded=0;whiteSpace=wrap;ht