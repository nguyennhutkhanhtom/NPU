<diagram id="33a_llm_soc_attention_value" name="llm_soc — attention value datapath"><mxGraphModel dx="900" dy="1105" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="900" pageHeight="1105" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="llm_soc — attention value datapath" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="840" height="30" as="geometry" /></mxCell><mxCell id="subtitle" value="Current RTL: pipelined attention value pass&lt;br/&gt;RTL: llm_soc.sv · clk; raw rst_n → u_reset → core_rst_n" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="840" height="42" as="geometry" /></mxCell><mxCell id="n_N0" value="Causal scores: timesteps 0 through position_q&lt;br/&gt;Read a score with its timestep tag" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;spacing=8;" vertex="1" parent="1" rtlSource="llm_soc.sv" architectureKind="functional logic"><mxGeometry x="200" y="125" width="500" height="76" as="geometry" /></mxCell><mxCell id="n_N1" value="Four-stage exp interpolation + timestep tags&lt;br/&gt;Whole pipeline stalls when its output cannot issue a V read" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=12;fontFamily=Arial;spacing=8;" vertex="1" parent="1" rtlSource="llm_soc.sv" architectureKind="functional logic"><mxGeometry x="200" y="230" width="500" height="76" as="geometry" /></mxCell><mxCell id="n_N2" value="Reserve one of eight slots before each KV V request&lt;br/&gt;Store probability U25 + timestep; five-edge KV read latency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Arial;spacing=8;" vertex="1" parent="1" rtlSource="llm_soc.sv" architectureKind="functional logic"><mxGeometry x="200" y="335" width="500" height="76" as="geometry" /></mxCell><mxCell id="n_N3" value="Accepted V responses fill the reserved FIFO&lt;br/&gt;Eight vectors, each 32 signed S24 lanes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;spacing=8;" vertex="1" parent="1" rtlSource="llm_soc.sv" architectureKind="functional logic"><mxGeometry x="200" y="440" width="500" height="76" as="geometry" /></mxCell><mxCell id="n_N4" value="Capture oldest probability / V pair into operand registers&lt;br/&gt;Preserve FIFO order; wait for math_in_ready" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;spacing=8;" vertex="1" parent="1" rtlSource="llm_soc.sv" architectureKind="functional logic"><mxGeometry x="200" y="545" width="500" height="76" as="geometry" /></mxCell><mxCell id="n_N5" value="Issue shared llm_math SIMD: 32 signed lane products&lt;br/&gt;Four stages of validity / timestep tags track the products" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=12;fontFamily=Arial;spacing=8;" vertex="1" parent="1" rtlSource="llm_soc.sv" architectureKind="functional logic"><mxGeometry x="200" y="650" width="500" height="76" as="geometry" /></mxCell><mxCell id="n_N6" value="Retire lane products in timestep order&lt;br/&gt;Accumulate S56 products into S64 attention_acc_q lanes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=12;fontFamily=Arial;spacing=8;" vertex="1" parent="1" rtlSource="llm_soc.sv" architectureKind="functional logic"><mxGeometry x="200" y="755" width="500" height="76" as="geometry" /></mxCell><mxCell id="n_N7" value="Drain exp, KV, operands, product tags and math_busy&lt;br/&gt;Then launch unchanged exact attention normalization" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;spacing=8;" vertex="1" parent="1" rtlSource="llm_soc.sv" architectureKind="functional logic"><mxGeometry x="200" y="860" width="500" height="76" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="n_N0" target="n_N1" style="endArrow=open;html=1;rounded=0;endFill=0;edgeStyle=segmentEdgeStyle;fontSize=11;strokeColor=#444444;exitX=0.50000;exitY=1.00000;entryX=0.50000;entryY=0.00000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" signalLabel="" rtlSource="llm_soc.sv" architectureKind="functional flow"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" source="n_N1" target="n_N2" style="endArrow=open;html=1;rounded=0;endFill=0;edgeStyle=segmentEdgeStyle;fontSize=11;strokeColor=#444444;exitX=0.50000;exitY=1.00000;entryX=0.50000;entryY=0.00000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" signalLabel="" rtlSource="llm_soc.sv" architectureKind="functional flow"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" edge="1" parent="1" source="n_N2" target="n_N3" style="endArrow=open;html=1;rounded=0;endFill=0;edgeStyle=segmentEdgeStyle;fontSize=11;strokeColor=#444444;exitX=0.50000;exitY=1.00000;entryX=0.50000;entryY=0.00000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" signalLabel="" rtlSource="llm_soc.sv" architectureKind="functional flow"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" edge="1" parent="1" source="n_N3" target="n_N4" style="endArrow=open;html=1;rounded=0;endFill=0;edgeStyle=segmentEdgeStyle;fontSize=11;strokeColor=#444444;exitX=0.50000;exitY=1.00000;entryX=0.50000;entryY=0.00000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" signalLabel="" rtlSource="llm_soc.sv" architectureKind="functional flow"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id=