Cell><mxCell id="15a-76" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="160" y="922" width="60" height="24" as="geometry"/></mxCell><mxCell id="15a-77" value="(rc16, ex) = recip16(sum)  (sum = 0 → rc16 = 0)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="220" y="922" width="780" height="24" as="geometry"/></mxCell><mxCell id="15a-78" value="Leading-zero counters: u85m_lzc × 3 (u: 62 b, sum: 32 b, max(mxa, 1): 33 b). ROMs RSQRT_BASE / SLOPE, RECIP_BASE / SLOPE (1024 entries) from u85m_rom_pkg, generated by scripts/gen_pkg.py from model/numerics.py; index = m_q[31:22], interpolation fraction m_q[21:14]: base + rnd(slope · f, 8)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="940" height="60" as="geometry"/></mxCell><mxCell id="15a-79" value="k is set only by SC_K (B32 segments); a B16 NORM uses k = 0 (input in32), never the k of an earlier B32 operation." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="940" height="40" as="geometry"/></mxCell><mxCell id="15a-80" value="u85m_ao_param — 32 records from 8 SB beats" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="510" width="580" height="620" as="geometry"/></mxCell><mxCell id="15a-81" value="bytes of a 16-byte record" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1060" y="550" width="200" height="24" as="geometry"/></mxCell><mxCell id="15a-82" value="field" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1260" y="550" width="340" height="24" as="geometry"/></mxCell><mxCell id="15a-83" value="0 – 5" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1060" y="574" width="200" height="24" as="geometry"/></mxCell><mxCell id="15a-84" value="pre_bias (int48)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1260" y="574" width="340" height="24" as="geometry"/></mxCell><mxCell id="15a-85" value="6 – 7" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1060" y="598" width="200" height="24" as="geometry"/></mxCell><mxCell id="15a-86" value="unused" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1260" y="598" width="340" height="24" as="geometry"/></mxCell><mxCell id="15a-87" value="8 – 11" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1060" y="622" width="200" height="24" as="geometry"/></mxCell><mxCell id="15a-88" value="mult (int32, ≥ 0)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1260" y="622" width="340" height="24" as="geometry"/></mxCell><mxCell id="15a-89" value="12 bits 5:0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1060" y="646" width="200" height="24" as="geometry"/></mxCell><mxCell id="15a-90" value="shift (0 … 63)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1260" y="646" width="340" height="24" as="geometry"/></mxCell><mxCell id="15a-91" value="13" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1060" y="670" width="200" height="24" as="geometry"/></mxCell><mxCell id="15a-92" value="unused" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1260" y="670" width="340" height="24" as="geometry"/></mxCell><mxCell id="15a-93" value="14 – 15" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1060" y="694" width="200" height="24" as="geometry"/></mxCell><mxCell id="15a-94" value="post_bias (int16)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1260" y="694" width="340" height="24" as="geometry"/></mxCell><mxCell id="15a-95" value="An SB beat holds records 4j … 4j + 3 (record i at bits 128·i). S_REC writes beat rc (0 … 7) to records 4·rc … 4·rc + 3.&lt;br&gt;&lt;br&gt;Read port: rq = issue mod 4 selects records 8·rq … 8·rq + 7 for the 8 lanes; they are captured in F1 at the issue.&lt;br&gt;&lt;br&gt;CONV: the 32 records of the OC group, loaded at the start of every group job (per-channel scale only).&lt;br&gt;NORM: 32 channels of pass 2 at a time; the SB job re-reads the seg records for every segment." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="730" width="540" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="u85m-25" name="16 AO passes"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="16-2" value="16 — u85m_ao passes per operation (pass kinds PK_*, phases PH_*)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="16-3" value="custom operations NORM, SOFTMAX, ROPE (opcodes 32, 33, 34) and CONV / ELEMENTWISE / LUT_LOAD · bit-exact definitions in docs/06 §2–8 · cycles measured by t_ao without stalls" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="20" as="geometry"/></mxCell><mxCell id="16-4" value="NORM  (job param[0] = RMS)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="500" height="30" as="geometry"/></mxCell><mxCell id="16-5" value="× rows, segments" style="rounded=1;arcSize=3;dashed=1;fillColor=none;verticalAlign=top;align=right;spacingRight=10;spacingTop=2;html=1;fontStyle=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="480" height="640" as="geometry"/></mxCell><mxCell id="16-6" value="PH_N_SEG  (B32 only)  PK_N0: IFMS → RB (32 b)&lt;br&gt;reduction RED_MAXABS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="440" height="60" as="geometry"/></mxCell><mxCell id="16-7" value="PH_N_K: S_SCAL SC_K&lt;br&gt;k = max(msb(max|x|) − 14, 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="265" width="440" height="60" as="geometry"/></mxCell><mxCell id="16-8" value="" style="endArrow=block;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" pa