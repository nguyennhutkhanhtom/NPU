ate (S100):&lt;br&gt;ISS cycle model, P = 56: 55.7 ms&lt;br&gt;58 ms (P = 128) … 75 ms (P = 1024)&lt;br&gt;→ 13–18 tokens / s&lt;br&gt;&lt;br&gt;M2: ISS = golden, bit-exact&lt;br&gt;(reports/m2_qwen3.md)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="860" width="260" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="u85m-32" name="23 Attention mapping"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="23-2" value="23 — Attention on the MAC array: MATMUL T, SOFTMAX, MATMUL D" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="23-3" value="decode at position p · P = p + 1 valid positions · P32 = ⌈P / 32⌉ · 32 · docs/08 §6–7" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="20" as="geometry"/></mxCell><mxCell id="23-4" value="GPT-2 head h (D = 64) — decode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1540" height="460" as="geometry"/></mxCell><mxCell id="23-5" value="q_h&lt;br&gt;1 × 64" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="130" height="36" as="geometry"/></mxCell><mxCell id