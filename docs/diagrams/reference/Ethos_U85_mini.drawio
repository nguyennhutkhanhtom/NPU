mxCell><mxCell id="05a-94" value="ram_cnt = entries in the RAM not yet read&lt;br&gt;issue = ram_cnt ≠ 0 and oq_cnt + v1 + v2 &amp;lt; 3 + pop&lt;br&gt;   (a read starts only if its data will find room in oq)&lt;br&gt;in_ready = ram_cnt ≠ DEPTH (not from out_ready)&lt;br&gt;out_valid = oq_cnt ≠ 0 · out_data = oq[oq_rp]&lt;br&gt;count = ram_cnt + v1 + v2 + oq_cnt (credit schemes)&lt;br&gt;1 entry per cycle; an entry pushed into an empty FIFO&lt;br&gt;is visible on the next cycle" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="500" width="490" height="190" as="geometry"/></mxCell><mxCell id="05a-95" value="Used for the DMA read-channel data FIFOs (32 … 128 beats of 512 b), where flip-flops would be too large." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1110" y="700" width="490" height="40" as="geometry"/></mxCell><mxCell id="05a-96" value="D. u85m_skid #(W) — register slice" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="500" height="340" as="geometry"/></mxCell><mxCell id="05a-97" value="output register&lt;br&gt;out_valid · out_data" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="840" width="170" height="60" as="geometry"/></mxCell><mxCell id="05a-98" value="skid register&lt;br&gt;skid_v · skid_d" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="950" width="170" height="60" as="geometry"/></mxCell><mxCell id="05a-99" value="" style="endArrow=open;html=1;rounded=0;endFill=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" paren