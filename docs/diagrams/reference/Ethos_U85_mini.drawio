itDx=0;exitDy=0;entryX=0;entryY=0.54;entryDx=0;entryDy=0;" edge="1" parent="1" source="14-51" target="14-62"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1340" y="420" as="sourcePoint"/><mxPoint x="1380" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14-64" value="" style="endArrow=open;html=1;rounded=0;endFill=0;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="14-62" target="14-62"><mxGeometry width="50" height="50" relative="1" as="geometry"><Array as="points"><mxPoint x="1530" y="520"/><mxPoint x="1430" y="520"/></Array><mxPoint x="1530" y="480" as="sourcePoint"/><mxPoint x="1430" y="480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14-65" value="acc" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="14-64"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="14-66" value="acc_valid = v5 &amp;amp;&amp;amp; l5&lt;br&gt;→ ab_push, ab_data lane d" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="600" width="200" height="60" as="geometry"/></mxCell><mxCell id="14-67" value="" style="endArrow=open;html=1;rounded=0;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="14-62" target="14-66"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1480" y="480" as="sourcePoint"/><mxPoint x="1480" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14-68" value="wop(w, w16, i): W8 → sign-extended byte i of the lane (INT8); W16 → 16-bit slot i for i &amp;lt; 4 (INT16), 0 for i ≥ 4 (the activations x[4..7] repeat x[0..3])" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="1500" height="20" as="geometry"/></mxCell><mxCell id="14-69" value="W8: INT16 × INT8 products (24 b), K ≤ 4096 → |acc| &amp;lt; 2^36 · W16 (MATMUL): INT16 × INT16 products (31 b), K ≤ 2048 → |acc| ≤ 2^41 &amp;lt; 2^47: the 48-bit accumulator never overflows" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="1500" height="20" as="geometry"/></mxCell><mxCell id="14-70" value="Control registers (v, first, last) are reset; data registers (x3, w3, p4, s5, acc) are not. clr clears the valid bits of every stage. Arria 10: 2 multipliers 18 × 18 per DSP block → 128 DSP for 256 multipliers (timing is tuned in M5)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="u85m-23" name="15 AO RTL"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="15-2" value="15 — u85m_ao: control, operand fetch, row / table buffer, pack (rtl/ao/u85m_ao.sv)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="15-3" value="8 lanes, one group of 8 elements per cycle · issue → F1 → F2 → P → lanes (8) → group FIFO → pack · docs/07 §6 · verified by t_ao" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width=