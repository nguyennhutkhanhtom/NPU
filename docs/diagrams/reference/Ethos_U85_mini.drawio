/></mxCell><mxCell id="06a-158" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="866" width="90" height="24" as="geometry"/></mxCell><mxCell id="06a-159" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1050" y="866" width="60" height="24" as="geometry"/></mxCell><mxCell id="06a-160" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1110" y="866" width="90" height="24" as="geometry"/></mxCell><mxCell id="06a-161" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1200" y="866" width="60" height="24" as="geometry"/></mxCell><mxCell id="06a-162" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1260" y="866" width="70" height="24" as="geometry"/></mxCell><mxCell id="06a-163" value="While soft_rst = 1: every unit clears its state, register writes are ignored, STATUS.reset_status = 1. It ends only when every bus port is idle, because an Avalon command already on a bus cannot be aborted (a write burst finishes with don&amp;#x27;t-care data, read beats are discarded)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="900" width="870" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="u85m-10" name="06b CC RTL u85m_fetch u85m_regs"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="06b-2" value="06b — u85m_fetch and u85m_regs (rtl/cc/)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="06b-3" value="command prefetch over m_cmd · credit rule · 512 → 32 bit words · shadow / active register sets · verified by t_decode" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="20" as="geometry"/></mxCell><mxCell id="06b-4" value="u85m_fetch (rtl/cc/u85m_fetch.sv)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1580" height="620" as="geometry"/></mxCell><mxCell id="06b-5" value="pointers&lt;br&gt;fptr = byte offset of the next request&lt;br&gt;fend = QSIZE rounded up to 64 B&lt;br&gt;start: fptr = qread &amp;amp; ~63" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="300" height="100" as="geometry"/></mxCell><mxCell id="06b-6" value="burst length&lt;br&gt;len = min(4, (fend − fptr) / 64,&lt;br&gt;64 − req_addr[11:6])&lt;br&gt;req_addr = qbase + fptr" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="300" height="100" as="geometry"/></mxCell><mxCell id="06b-7" value="can_issue =&lt;br&gt;active &amp;amp;&amp;amp; !m_read &amp;amp;&amp;amp; fptr &amp;lt; fend &amp;amp;&amp;amp;&lt;br&gt;f_count + inflight + len ≤ 8" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="300" height="100" as="geometry"/></mxCell><mxCell id="06b-8" value="Avalon request register&lt;br&gt;m_read · m_address · m_burstcount&lt;br&gt;held until m_waitrequest 