eft=6;" vertex="1" parent="1"><mxGeometry x="1270" y="452" width="340" height="24" as="geometry"/></mxCell><mxCell id="08a-140" value="14" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="960" y="476" width="60" height="24" as="geometry"/></mxCell><mxCell id="08a-141" value="u_macq" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1020" y="476" width="140" height="24" as="geometry"/></mxCell><mxCell id="08a-142" value="mac_job_t" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1160" y="476" width="110" height="24" as="geometry"/></mxCell><mxCell id="08a-143" value="MAC" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1270" y="476" width="340" height="24" as="geometry"/></mxCell><mxCell id="08a-144" value="15" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="960" y="500" width="60" height="24" as="geometry"/></mxCell><mxCell id="08a-145" value="u_aoq" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1020" y="500" width="140" height="24" as="geometry"/></mxCell><mxCell id="08a-146" value="ao_job_t" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1160" y="500" width="110" height="24" as="geometry"/></mxCell><mxCell id="08a-147" value="AO" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1270" y="500" width="340" height="24" as="geometry"/></mxCell><mxCell id="08a-148" value="A full FIFO stalls S_RUN. Pushing in program order cannot deadlock: every unit takes its jobs in order and only waits for data or flags from jobs pushed earlier (streams, WB full, IB ib_full, AB credits). S_DRAIN ends when every FIFO is empty (q_empty) and units_idle." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="555" width="650" height="66" as="geometry"/></mxCell><mxCell id="08a-149" value="u85m_opcheck (rtl/cc/u85m_opcheck.sv): combinational; the first violated constraint of 03-isa.md §6 in the order of compiler/check.py describe() gives the code (0 = legal)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1580" height="490" as="geometry"/></mxCell><mxCell id="08a-150" value="step" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="170" height="24" as="geometry"/></mxCell><mxCell id="08a-151" value="checks (error code)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="700" width="1370" height="24" as="geometry"/></mxCell><mxCell id="08a-152" value="DMA_START" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="724" width="170" height="46" as="geometry"/></mxCell><mxCell id="08a-153" value="source region not internal (REGION) · length / source aligned (ALIGN) · LUT load: slot &amp;lt; 4, source in DDR (REGION), 2048 bytes (SIZE) · else destination aligned (ALIGN) · scratchpad ranges (SRAM)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="724" width="1370" height="46" as="geometry"/></mxCell><mxCell id="08a-154" value="opcode" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="170" height="24" as="geometry"/></mxCell><mxCell id="08a-155" value="not CONV, ELEMENTWISE, NORM, SOFTMAX, ROPE → CMD0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="770" width="1370" height="24" as="geometry"/></mxCell><mxCell id="08a-156" value="IFM / OFM" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="794" width="170" height="46" as="geometry"/></mxCell><mxCell id="08a-157" value="IFM and OFM precision (PREC) · OFM width = T (SHAPE) · T ≤ 65536 (SIZE) · base / stride aligned (ALIGN) · C, N multiples of 32 (DEPTH32) · activation NONE or LUT, slot &amp;lt; 4 (PREC, REGION)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="794" width="1370" height="46" as="geometry"/></mxCell><mxCell id="08a-158" value="FC" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="170" height="46" as="geometry"/></mxCell><mxCell id="08a-159" value="B16 IFM (PREC) · K ≤ 4096 (SIZE) · B32 OFM only per-channel without LUT (PREC) · weight stream lengths (WLEN) · weights in DDR (REGION), aligned (ALIGN) · per-channel: SCALE_LENGTH = 16·N (SLEN), DDR, aligned" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="840" width="1370" height="46" as="geometry"/></mxCell><mxCell id="08a-160" value="MATMUL" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="886" width="170" height="46" as="geometry"/></mxCell><mxCell id="08a-161" value="B16 IFM and OFM (PREC) · per-tensor, no activation (MATMUL) · K ≤ 2048, TRANSPOSE K ≤ 256 (SIZE) · IFM2 B16 (PREC), valid rows ≤ rows (SHAPE), aligned (ALIGN)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="886" width="1370" height="46" as="geometry"/></mxCell><mxCell id="08a-162" value="ELEMENTWISE" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="932" width="170" height="46" as="geometry"/></mxCell><mxCell id="08a-163" value="mode MUL / ADD / SUB / MAX (CMD0) · C ≤ 4096 (SIZE) · N = C (SHAPE) · broadcast NONE / W / SCALAR (CMD0) · IFM2 precision, rows, alignment · B32 only ADD / SUB without broadcast (PREC)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="932" width="1370" height="46" as="geometry"/></mxCell><mxCell id="08a-164" value="NORM, SOFTMAX, ROPE" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="978" width="170" height="46" as="geometry"/></mxCell><mxCell id="08a-165" value="C ≤ 4096 (SIZE) · N = C (SHAPE) · B16 OFM (PREC) · NORM: SEG_LEN divides C, multiple of 32 (SEG), B32 SEG_LEN ≤ 2048 (SIZE), scale length / region / alignment · SOFTMAX: B16 IFM, LUT slot · ROPE: B16, SEG, SEG_LEN ≤ 256 (SIZE), IFM2 B16, broadcast, rows, alignment" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="230" y="978" width="1370" height="46" as="geometry"/></mxCell><mxCell id="08a-166" value="scratchpad" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="1024" width="170" height="24" as="geometry"/></mxCell><mxCell id="08a-167" value="IFM, IFM2, OFM ranges inside the 512 KiB scratchpad when their r