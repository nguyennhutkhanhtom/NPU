="50" as="geometry"/></mxCell><mxCell id="11-151" value="Expected word in t_wd: word w, lane oc, byte i = beat 4w + i/2, byte oc + 32·(i mod 2)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1050" width="1100" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="u85m-20" name="12 Tensor core RTL"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="12-2" value="12 — tensor core u85m_tc (rtl/wd/u85m_tc.sv)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="12-3" value="MATMUL operands from the TC stream: DIRECT (P·V) straight into the WB, TRANSPOSE (Q·Kᵀ) through 32 skewed staging RAMs · docs/07 §4.2 · verified by t_wd" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="20" as="geometry"/></mxCell><mxCell id="12-4" value="tc_job_t field" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="150" height="24" as="geometry"/></mxCell><mxCell id="12-5" value="DIRECT (P·V)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="190" y="110" width="220" height="24" as="geometry"/></mxCell><mxCe