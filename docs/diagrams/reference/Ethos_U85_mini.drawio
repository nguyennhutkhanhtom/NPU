72" height="30" as="geometry"/></mxCell><mxCell id="17-69" value="AO → OB" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="150" height="30" as="geometry"/></mxCell><mxCell id="17-70" value="16 rows, 4 cycles each, as rows finish" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="298" y="600" width="266" height="30" as="geometry"/></mxCell><mxCell id="17-71" value="MAC busy every cycle after the first group · each group: 16 × 128 = 2048 MAC cycles vs 512 cycles of weights · 96 groups ≈ 197 k cycles for 16 tokens" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="1500" height="40" as="geometry"/></mxCell><mxCell id="17-72" value="rules" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1500" height="120" as="geometry"/></mxCell><mxCell id="17-73" value="• WD core s writes bank s; it waits for wb_full[s] = 0 before a group, sets it at the end of the group&lt;br&gt;• the MAC waits for wb_full, ib_full and a free AB entry (reservation) before each row; it clears wb_full when it starts the last row of the group and ib_full at the last read of the token block&lt;br&gt;• AO pops one AB entry in 4 cycles (8 lanes) and writes one 512-bit OFM beat per row and group&lt;br&gt;• the next operation starts only when every job FIFO is empty and every unit is idle (units_idle)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="1460" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="u85m-27" name="18 Register map"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="18-2" value="18 — Host register map (4 KiB window at BAR4 + 0x80000)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="18-3" value="32-bit accesses · offsets 0x000–0x0BC, 0x27C, 0x2B8, 0x2BC as in Ethos-U85 · docs/04" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="20" as="geometry"/></mxCell><mxCell id="18-4" value="Offset" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="110" height="24" as="geometry"/></mxCell><mxCell id="18-5" value="Register" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="150" height="24" as="geometry"/></mxCell><mxCell id="18-6" value="Access" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="70" height="24" as="geometry"/></mxCell><mxCell id="18-7" value="Reset" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align