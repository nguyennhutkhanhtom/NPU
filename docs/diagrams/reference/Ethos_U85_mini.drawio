"geometry"><mxPoint x="1340" y="740" as="sourcePoint"/><mxPoint x="1600" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="09b-59" value="Avalon write" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="09b-58"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="09b-60" value="" style="endArrow=open;html=1;rounded=0;endFill=0;entryX=1;entryY=0.44;entryDx=0;entryDy=0;" edge="1" parent="1" target="09b-54"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1600" y="870" as="sourcePoint"/><mxPoint x="1340" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="09b-61" value="waitrequest" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="09b-60"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="09b-62" value="byteenable = all ones. A started burst always completes, also during clr (don&amp;#x27;t-care data from the emptied FIFO); no new burst while clr = 1. idle = !m_write." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="960" width="500" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="u85m-17" name="09c DMA RTL arbiter and scratchpad port"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="09c-2" value="09c — u85m_rw_arb, u85m_sram_port, u85m_sram and soft reset" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="09c-3" value="one m_data bus for reads and writes · Avalon slave front end of the scratchpad · clr contract · docs/07 §3.3-3.4" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="20" as="geometry"/></mxCell><mxCell id="09c-4" value="u85m_rw_arb (rtl/dma/u85m_rw_arb.sv)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="760" height="500" as="geometry"/></mxCell><mxCell id="09c-5" value="owner = read&lt;br&gt;rd_grant = !(served &amp;amp;&amp;amp; wr_want)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="170" height="60" as="geometry"/></mxCell><mxCell id="09c-6" value="owner = write&lt;br&gt;wr_grant = !(served &amp;amp;&amp;amp; rd_want)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="180" width="170" height="60" as="geometry"/></mxCell><mxCell id="09c-7" value="" style="endArrow=open;html=1;rounded=0;endFill=0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="09c-5" target="09c-6"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="240" y="195" as="sourcePoint"/><mxPoint x="600" y="195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="09c-8" value="free &amp;amp;&amp;amp; wr_want &amp;amp;&amp;amp; (!rd_want || served)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="09c-7"><mxGeometry x="0" y="12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="09c-9" value="" style="endArrow=open;html=1;rounded=0;endFill=0;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="09c-6" target="09c-5"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="600" y="225" as="sourcePoint"/><mxPoint x="240" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="09c-10" value="free &amp;amp;&amp;amp; rd_want &amp;amp;&amp;amp; (!wr_want || served)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="09c-9"><mxGeometry x="0" y="12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="09c-11" value="free = no read command held (rd_busy), no write burst in progress (wr_busy), nothing starting this cycle (rd_start, wr_start).&lt;br&gt;served = the owner has started at least one command since it got the bus; then the owner&amp;#x27;s grant is withheld while the other side wants the bus → reads and writes alternate burst by burst.&lt;br&gt;Only the owner&amp;#x27;s port may start (grant); address / burstcount of m_data come from the port whose command is on the bus (m_data_write)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="710" height="130" as="geometry"/></mxCell><mxCell id="09c-12" value="cycle" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="90" height="24" as="geometry"/></mxCell><mxCell id="09c-13" value="0" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="160" y="440" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-14" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="440" width="110" height="24" as="geometry"/></mxCell><mxCell id="09c-15" value="2" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="440" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-16" value="3 … 18" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="440" width="120" height="24" as="geometry"/></mxCell><mxCell id="09c-17" value="19" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="550" y="440" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-18" value="20" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="440" width="90" height="24" as="geometry"/></mxCell><mxCell id="09c-19" value="owner" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="464" width="90" height="24" as="geometry"/></mxCell><mxCell id="09c-20" value="rd" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="160" y="464" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-21" value="rd" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="464" width="110" height="24" as="geometry"/></mxCell><mxCell id="09c-22" value="rd" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="464" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-23" value="wr" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="464" width="120" height="24" as="geometry"/></mxCell><mxCell id="09c-24" value="wr" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="550" y="464" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-25" value="rd" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="464" width="90" height="24" as="geometry"/></mxCell><mxCell id="09c-26" value="m_read" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="488" width="90" height="24" as="geometry"/></mxCell><mxCell id="09c-27" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="160" y="488" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-28" value="0 (accepted)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="488" width="110" height="24" as="geometry"/></mxCell><mxCell id="09c-29" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="488" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-30" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="488" width="120" height="24" as="geometry"/></mxCell><mxCell id="09c-31" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="550" y="488" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-32" value="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="488" width="90" height="24" as="geometry"/></mxCell><mxCell id="09c-33" value="m_write" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="512" width="90" height="24" as="geometry"/></mxCell><mxCell id="09c-34" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="160" y="512" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-35" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="512" width="110" height="24" as="geometry"/></mxCell><mxCell id="09c-36" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="512" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-37" value="1 (16 beats)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="512" width="120" height="24" as="geometry"/></mxCell><mxCell id="09c-38" value="0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="550" y="512" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-39" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="512" width="90" height="24" as="geometry"/></mxCell><mxCell id="09c-40" value="event" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="536" width="90" height="24" as="geometry"/></mxCell><mxCell id="09c-41" value="rd_start" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="160" y="536" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-42" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="240" y="536" width="110" height="24" as="geometry"/></mxCell><mxCell id="09c-43" value="switch" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="536" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-44" value="burst" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="536" width="120" height="24" as="geometry"/></mxCell><mxCell id="09c-45" value="switch" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="550" y="536" width="80" height="24" as="geometry"/></mxCell><mxCell id="09c-46" value="rd_start" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="536" width="90" height="24" as="geometry"/></mxCell><mxCell id="09c-47" value="Example: a read command, then a pending OFM write burst, then the next read." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="565" width="700" height="20" as="geometry"/></mxCell><mxCell id="09c-48" value="u85m_sram_port + u85m_sram (rtl/dma/u85m_sram_port.sv, rtl/mem/u85m_sram.sv)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="780" height="500" as="geometry"/></mxCell><mxCell id="09c-49" value="read: accept a burst when rleft = 0&lt;br&gt;rptr ← address[18:6], rleft ← burstcount&lt;br&gt;one RAM read per cycle, waitrequest = 1 while streaming" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="150" width="360" height="80" as="geometry"/></mxCell><mxCell id="09c-50" value="valid pipe v1 → v2&lt;br&gt;(RAM read latency 2)&lt;br&gt;readdatavalid = v2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="270" width="360" height="70" as="geometry"/></mxCell><mxCell id="09c-51" value="write: waitrequest = 0 always&lt;br&gt;first beat: address[18:6]&lt;br&gt;then wptr + 1 per beat" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="380" width="360" height="70" as="geometry"/></mxCell><mxCell id="09c-52" value="u85m_sram&lt;br&gt;u85m_ram_1r1w&lt;br&gt;8192 × 512 b&lt;br&gt;1 read + 1 write&lt;br&gt;per cycle" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="230" width="220" height="150" as="geometry"/></mxCell><mxCell id="09c-53" value="" style="endArrow=open;html=1;rounded=0;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="09c-49" target="09c-50"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1050" y="230" as="sourcePoint"/><mxPoint x="1050" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="09c-54" value="" style="endArrow=open;html=1;rounded=0;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="09c-49" target="09c-52"><mxGeometry width="50" height="50" relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="190"/><mxPoint x="1300" y="280"/></Array><mxPoint x="1230" y="190" as="sourcePoint"/><mxPoint x="1360" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="09c-55" value="sram_re · sram_raddr" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="09c-54"><mxGeometry x="-0.4" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="09c-56" value="" style="endArrow=open;html=1;rounded=0;endFill=0;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.71;entryDx=0;entryDy=0;" edge="1" parent="1" source="09c-52" target="09c-50"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1360" y="320" as="sourcePoint"/><mxPoint x="1230" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="09c-57" value="sram_rdata" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="09c-56"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="09c-58" value="" style="endArrow=open;html=1;rounded=0;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="09c-51" target="09c-52"><mxGeometry width="50" height="50" relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="415"/><mxPoint x="1300" y="350"/></Array><mxPoint x="1230" y="415" as="sourcePoint"/><mxPoint x="1360" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="09c-59" value="sram_we · waddr · wdata" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="09c-58"><mxGeometry x="-0.4" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="09c-60" value="The scratchpad looks like one more Avalon-MM slave, so the same port masters (u85m_port_rd / u85m_port_wr) serve DDR and scratchpad regions. Reads stream 1 beat / cycle; writes never wait. Bits 18:6 of the byte address select the beat (512 KiB)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="480" width="720" height="80" as="geometry"/></mxCell><mxCell id="09c-61" value="soft reset (clr) contract of the DMA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="1580" height="300" as="geometry"/></mxCell><mxCell id="09c-62" value="step" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="680" width="180" height="24" as="geometry"/></mxCell><mxCell id="09c-63" value="what happens" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="680" width="820" height="24" as="geometry"/></mxCell><mxCell id="09c-64" value="1  RESET written" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="704" width="180" height="24" as="geometry"/></mxCell><mxCell id="09c-65" value="u85m_csr raises soft_rst → clr of every channel and port" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="704" width="820" height="24" as="geometry"/></mxCell><mxCell id="09c-66" value="2  channels" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="728" width="180" height="24" as="geometry"/></mxCell><mxCell id="09c-67" value="u85m_dma_rd / u85m_dma_wr: active = 0, FIFOs emptied and kept empty while clr = 1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="728" width="820" height="24" as="geometry"/></mxCell><mxCell id="09c-68" value="3  read ports" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="752" width="180" height="40" as="geometry"/></mxCell><mxCell id="09c-69" value="no new command; a command on the bus stays until accepted; beats still owed arrive and are discarded by the empty channel FIFOs" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="752" width="820" height="40" as="geometry"/></mxCell><mxCell id="09c-70" value="4  write ports" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="792" width="180" height="24" as="geometry"/></mxCell><mxCell id="09c-71" value="a burst already started completes (don&amp;#x27;t-care data); no new burst" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="792" width="820" height="24" as="geometry"/></mxCell><mxCell id="09c-72" value="5  idle" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="816" width="180" height="24" as="geometry"/></mxCell><mxCell id="09c-73" value="all 7 ports idle → u85m_dma.idle = 1 → bus_idle (with f_idle of u85m_fetch)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="816" width="820" height="24" as="geometry"/></mxCell><mxCell id="09c-74" value="6  release" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="70" y="840" width="180" height="24" as="geometry"/></mxCell><mxCell id="09c-75" value="u85m_csr: srst_cnt waits at 1 until bus_idle → soft_rst = 0 (at least 16 cycles)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="840" width="820" height="24" as="geometry"/></mxCell><mxCell id="09c-76" value="Assertion a_clr_until_idle (u85m_dma): clr may fall only when idle = 1.&lt;br&gt;Why: an Avalon command cannot be aborted; if clr were released earlier, beats of an old read could land in a new job&amp;#x27;s FIFO, and an old write burst could pull a new job&amp;#x27;s data.&lt;br&gt;t_dma aborts random rounds with clr and checks that the DMA returns to idle and then works normally; mutating the contract (early release, start during clr) makes the test fail." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="680" width="490" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="u85m-18" name="10 DMA addressing and bursts"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="10-2" value="10 — DMA addressing and bursts" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="10-3" value="row address = base + (r &amp;gt;&amp;gt; rshift) · stride · zero rows · burst split · Avalon read with tag FIFO · docs/07 §3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="20" as="geometry"/></mxCell><mxCell id="10-4" value="A. tensor rows in memory  ([W][C] INT16 or INT32, rows 64-byte aligned)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="740" height="330" as="geometry"/></mxCell><mxCell id="10-5" value="row 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;round