gnored (write) / read 0. A SET writes the shadow set only, so the decoder can prepare operation n + 1 while operation n runs from the active set." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="1010" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="u85m-11" name="07 Command stream encoding"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="07-2" value="07 — Command stream encoding (identical to Ethos-U85)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="07-3" value="32-bit little-endian words · cmd0 = 1 word, cmd1 = 2 words · addresses are offsets inside a region · docs/03" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="20" as="geometry"/></mxCell><mxCell id="07-4" value="cmd0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="60" height="40" as="geometry"/></mxCell><mxCell id="07-5" value="param16" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="130" width="416" height="40" as="geometry"/></mxCell><mxCell id="07-6" value="31" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;" vertex="1" parent="1"><mxGeome