Geometry x="0.2" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="13-137" value="" style="endArrow=none;html=1;rounded=0;dashed=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="13-111"><mxGeometry width="50" height="50" relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="330"/></Array><mxPoint x="900" y="540" as="sourcePoint"/><mxPoint x="1050" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="13-138" value="ib_full / ib_clr, wb_full / wb_clr: flags (u85m_ib, u85m_wb)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1050" y="320" width="270" height="20" as="geometry"/></mxCell><mxCell id="13-139" value="what one OC group computes (T_b rows of one token block)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1580" height="270" as="geometry"/></mxCell><mxCell id="13-140" value="IFM rows t&lt;br&gt;(T_b × K, INT16)&lt;br&gt;IB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="890" width="180" height="120" as="geometry"/></mxCell><mxCell id="13-141" value="×" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;" vertex="1" parent="1"><mxGeometry x="270" y="930" width="40" height="40" as="geometry"/></mxCell><mxCell id="13-142" value="W group g&lt;br&gt;(32 × K, INT8 or INT16)&lt;br&gt;WB bank g &amp;amp; 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="320" y="890" width="200" height="120" as="geometry"/></mxCell><mxCell id="13-143" value="=" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=20;" vertex="1" parent="1"><mxGeometry x="530" y="930" width="40" height="40" as="geometry"/></mxCell><mxCell id="13-144" value="acc&lt;br&gt;(T_b × 32, 48 b)&lt;br&gt;→ AB, one entry per row" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" vertex="1" parent="1"><mxGeometry x="580" y="890" width="200" height="120" as="geometry"/></mxCell><mxCell id="13-145" value="words = K/8 steps per row (W8) or K/4 (W16); the WB group is reused for all T_b rows (output-stationary).&lt;br&gt;Decode (T = 1) and prefill (T_b ≤ 16) use the same datapath.&lt;br&gt;A group takes about max(T_b · words, 4 · words) cycles: MAC steps versus weight streaming (4 beats or 4 columns per WB word).&lt;br&gt;The job with last = 1 (last OC group) releases the IB at its last read; the IB writer then loads the next token block." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="890" width="780" height="120" as="geometry"/></mxCell><mxCell id="13-146" value="Activations: IB word = 32 × INT16 (input channels 32i … 32i + 31). W8 step kw: input channels 8kw … 8kw + 7 = bits 128·(kw &amp;amp; 3) of IB word kw &amp;gt;&amp;gt; 2. W16 step kw: input channels 4kw … 4kw + 3 = bits 64·(kw &amp;amp; 7) of IB word kw &amp;gt;&amp;gt; 3." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1030" width="1520" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="u85m-22" name="14 DPU pipeline RTL"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="14-2" value="14 — MAC pipeline and DPU (rtl/mac/u85m_mac.sv, u85m_dpu.sv × 32)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="14-3" value="one step per cycle; a step issued in cycle c is accumulated at the end of cycle c + 5 · docs/07 §5.3 · verified by t_mac" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="20" as="geometry"/></mxCell><mxCell id="14-4" value="S0 · u85m_mac" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="200" height="30" as="geometry"/></mxCell><mxCell id="14-5" value="S1 · RAM" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="200" height="30" as="geometry"/></mxCell><mxCell id="14-6" value="" style="endArrow=none;html=1;rounded=0;dashed=1;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="270" y="140" as="sourcePoint"/><mxPoint x="270" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14-7" value="S2 · RAM" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="200" height="30" as="geometry"/></mxCell><mxCell id="14-8" value="" style="endArrow=none;html=1;rounded=0;dashed=1;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="490" y="140" as="sourcePoint"/><mxPoin