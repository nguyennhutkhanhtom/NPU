 x="50" y="510" as="sourcePoint"/><mxPoint x="150" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="09b-47" value="req_valid[N]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;" vertex="1" connectable="0" parent="09b-46"><mxGeometry x="0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="09b-48" value="grant / want / start / busy: for u85m_rw_arb (grant = 1 when the port has the bus alone). idle = !m_read &amp;amp;&amp;amp; tag FIFO empty. a_no_orphan: every readdatavalid has a tag." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="1010" width="950" height="40" as="geometry"/></mxCell><mxCell id="09b-49" value="Beats come back in request order (Avalon), so an in-order tag FIFO is enough to find the channel." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="1060" width="950" height="20" as="geometry"/></mxCell><mxCell id="09b-50" value="u85m_port_wr #(N) — write master shared by N channels" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1080" y="430" width="540" height="700" as="geometry"/></mxCell><mxCell id="09b-51" value="fixed priority&lt;br&gt;lowest index wins&lt;br&gt;(OFM before M2M_WR)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="480" width="220" height="70" as="geometry"/></mxCell><mxCell id="09b-52" value="start = !m_write &amp;amp;&amp;amp; grant&lt;br&gt;&amp;amp;&amp;amp; found &amp;amp;&amp;amp; !clr" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeome