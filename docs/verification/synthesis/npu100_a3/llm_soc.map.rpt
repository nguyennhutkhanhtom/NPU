Encoding Type:  One-Hot
+-----------------------------------------------------------------------------------------------------------------------+
; State Machine - |llm_soc|host_state                                                                                   ;
+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+
; Name              ; host_state.H_WAIT ; host_state.H_READ ; host_state.H_EXEC ; host_state.H_IDLE ; host_state.H_DONE ;
+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+
; host_state.H_IDLE ; 0                 ; 0                 ; 0                 ; 0                 ; 0                 ;
; host_state.H_EXEC ; 0                 ; 0                 ; 1                 ; 1                 ; 0                 ;
; host_state.H_READ ; 0                 ; 1                 ; 0                 ; 1                 ; 0                 ;
; host_state.H_WAIT ; 1                 ; 0                 ; 0                 ; 1                 ; 0                 ;
; host_state.H_DONE ; 0                 ; 0                 ; 0                 ; 1                 ; 1                 ;
+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+


Encoding Type:  One-Hot
+------------------------------------------------------------------------------------------------------------------+
; State Machine - |llm_soc|sigmoid:u_sig|state                                                                     ;
+----------------+-------------+-----------+----------------+-------------+-------------+-------------+------------+
; Name           ; state.ROUND ; state.ADD ; state.MULTIPLY ; state.SLOPE ; state.READ1 ; state.READ0 ; state.IDLE ;
+----------------+-------------+-----------+----------------+-------------+-------------+-------------+------------+
; state.IDLE     ; 0           ; 0         ; 0              ; 0           ; 0           ; 0           ; 0          ;
; state.READ0    ; 0           ; 0         ; 0              ; 0           ; 0           ; 1           ; 1          ;
; state.READ1    ; 0           ; 0         ; 0              ; 0           ; 1           ; 0           ; 1          ;
; state.SLOPE    ; 0           ; 0         ; 0              ; 1           ; 0           ; 0           ; 1          ;
; state.MULTIPLY ; 0           ; 0         ; 1              ; 0           ; 0           ; 0           ; 1          ;
; state.ADD      ; 0           ; 1         ; 0              ; 0           ; 0           ; 0           ; 1          ;
; state.ROUND    ; 1           ; 0         ; 0              ; 0           ; 0           ; 0           ; 1          ;
+----------------+-------------+-----------+----------------+-------------+-------------+-------------+------------+


