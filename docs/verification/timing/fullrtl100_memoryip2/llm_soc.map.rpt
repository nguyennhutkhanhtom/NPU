; state.READ0    ; 0           ; 0         ; 0              ; 0           ; 0           ; 1           ; 1          ;
; state.READ1    ; 0           ; 0         ; 0              ; 0           ; 1           ; 0           ; 1          ;
; state.SLOPE    ; 0           ; 0         ; 0              ; 1           ; 0           ; 0           ; 1          ;
; state.MULTIPLY ; 0           ; 0         ; 1              ; 0           ; 0           ; 0           ; 1          ;
; state.ADD      ; 0           ; 1         ; 0              ; 0           ; 0           ; 0           ; 1          ;
; state.ROUND    ; 1           ; 0         ; 0              ; 0           ; 0           ; 0           ; 1          ;
